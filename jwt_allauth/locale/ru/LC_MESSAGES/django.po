#: authentication.py:70
msgid "Session is no longer active."
msgstr "Сессия больше не активна."

#: exceptions.py:10
msgid "User email is not verified"
msgstr "Адрес электронной почты пользователя не подтверждён"

#: exceptions.py:16
msgid "Session reached its maximum lifetime. Please log in again"
msgstr "Сессия достигла максимального срока жизни. Войдите снова"

#: exceptions.py:22
msgid "Incorrect credentials"
msgstr "Неверные учётные данные"

#: exceptions.py:53
msgid "This account requires a second factor."
msgstr "Для этой учётной записи требуется второй фактор."

#: exceptions.py:63
msgid "This provider is not configured."
msgstr "Этот провайдер не настроен."

#: exceptions.py:69
msgid "This provider does not support this authentication flow."
msgstr "Этот провайдер не поддерживает такой способ аутентификации."

#: exceptions.py:75 social/flows.py:251
msgid "The provider rejected the credential."
msgstr "Провайдер отклонил учётные данные."

#: exceptions.py:87
msgid "The provider did not supply a verified e-mail address."
msgstr "Провайдер не предоставил подтверждённый адрес электронной почты."

#: exceptions.py:93
msgid "This provider account is already connected to another user."
msgstr "Эта учётная запись провайдера уже связана с другим пользователем."

#: exceptions.py:105 registration/serializers.py:22
msgid "A user is already registered with this e-mail address."
msgstr "Пользователь с таким адресом электронной почты уже зарегистрирован."

#: exceptions.py:127
msgid "Confirm this e-mail address on the existing account before connecting a provider."
msgstr "Подтвердите этот адрес электронной почты в существующей учётной записи, прежде чем связывать провайдера."

#: exceptions.py:133
msgid "Registration is closed."
msgstr "Регистрация закрыта."

#: exceptions.py:139
msgid "Signing up through a provider is not allowed."
msgstr "Регистрация через провайдера не разрешена."

#: exceptions.py:145
msgid "This social login was rejected."
msgstr "Этот вход через провайдера отклонён."

#: exceptions.py:151
msgid "This provider cannot be disconnected."
msgstr "Этого провайдера нельзя отвязать."

#: logout/views.py:47
msgid "Refresh token cookie not found."
msgstr "Cookie с токеном обновления не найдена."

#: logout/views.py:57
msgid "Successfully logged out."
msgstr "Выход выполнен успешно."

#: logout/views.py:62
msgid "Invalid token."
msgstr "Недействительный токен."

#: logout/views.py:89
msgid "Successfully logged out from all devices."
msgstr "Выход со всех устройств выполнен успешно."

#: mfa/views.py:202 registration/views.py:87 registration/views.py:146
msgid "Verification e-mail sent."
msgstr "Письмо для подтверждения отправлено."

#: password_change/serializers.py:39
msgid "Your old password was entered incorrectly. Please enter it again."
msgstr "Старый пароль введён неверно. Введите его ещё раз."

#: password_change/views.py:49
msgid "New password has been saved."
msgstr "Новый пароль сохранён."

#: password_reset/views.py:108
msgid "Too many password reset requests for this e-mail address."
msgstr "Слишком много запросов на сброс пароля для этого адреса электронной почты."

#: password_reset/views.py:113
msgid "Password reset e-mail has been sent."
msgstr "Письмо для сброса пароля отправлено."

#: password_reset/views.py:266
msgid "Password reset."
msgstr "Пароль сброшен."

#: password_reset/views.py:321
msgid "Password set. Please configure MFA to complete registration."
msgstr "Пароль задан. Настройте MFA, чтобы завершить регистрацию."

#: password_reset/views.py:329
msgid "Password set."
msgstr "Пароль задан."

#: permissions.py:144
msgid "E-mail address is not verified."
msgstr "Адрес электронной почты не подтверждён."

#: registration/serializers.py:164
msgid "The two password fields didn't match."
msgstr "Пароли не совпадают."

#: registration/serializers.py:255
msgid "Role is required"
msgstr "Роль обязательна"

#: social/adapter.py:61
msgid "This is the only way to sign in to this account."
msgstr "Это единственный способ войти в эту учётную запись."

#: social/flows.py:124 social/flows.py:167
msgid "The credential was not issued for this application."
msgstr "Эти учётные данные выданы не для этого приложения."

#: social/flows.py:154 social/serializers.py:23
msgid "Either an id_token or an access_token is required."
msgstr "Требуется id_token или access_token."

#: social/flows.py:209
msgid "This callback_url is not allowed."
msgstr "Этот callback_url не разрешён."

#: social/flows.py:370
msgid "No active account found with the given credentials"
msgstr "Активная учётная запись с указанными учётными данными не найдена"

#: templates/email/account_exists/email_message.html:8 templates/email/account_exists/email_message.html:69 templates/email/account_exists/email_subject.txt:2
msgid "You already have an account"
msgstr "У вас уже есть учётная запись"

#: templates/email/account_exists/email_message.html:74
msgid "Somebody just tried to sign up with this email address, but an account already exists for it. No new account has been created and nothing has changed."
msgstr "Кто-то только что попытался зарегистрироваться с этим адресом электронной почты, но учётная запись для него уже существует. Новая учётная запись не создана, ничего не изменилось."

#: templates/email/account_exists/email_message.html:76
msgid "If it was you, sign in with your usual credentials. If you do not remember your password, request a password reset instead of signing up again."
msgstr "Если это были вы, войдите со своими обычными данными. Если вы не помните пароль, запросите его сброс вместо повторной регистрации."

#: templates/email/account_exists/email_message.html:79
msgid "If it was not you and this address is yours, somebody else may be using it on an account you never created. Reset the password to take control of the account: doing so signs out everybody who is currently using it."
msgstr "Если это были не вы, а адрес принадлежит вам, возможно, кто-то другой использует его в учётной записи, которую вы не создавали. Сбросьте пароль, чтобы получить контроль над ней: при этом все, кто ею сейчас пользуется, будут разлогинены."

#: templates/email/account_exists/email_message.html:84 templates/email/password/reset_email_message.html:82
msgid "Reset Password"
msgstr "Сбросить пароль"

#: templates/email/account_exists/email_message.html:87 templates/email/password/reset_email_message.html:85 templates/email/signup/email_message.html:76
msgid "If the button above doesn't work, you can also copy and paste the following link into your browser:"
msgstr "Если кнопка выше не работает, скопируйте и вставьте в браузер следующую ссылку:"

#: templates/email/account_exists/email_message.html:93 templates/email/admin_invite/email_message.html:99 templates/email/password/reset_email_message.html:91 templates/email/signup/email_message.html:83
msgid "This is an automated message, please do not reply to this email."
msgstr "Это автоматическое сообщение, пожалуйста, не отвечайте на него."

#: templates/email/account_exists/email_message.html:94 templates/email/admin_invite/email_message.html:100 templates/email/password/reset_email_message.html:92 templates/email/signup/email_message.html:84
msgid "If you have any questions, please contact our support team."
msgstr "Если у вас есть вопросы, обратитесь в нашу службу поддержки."

#: templates/email/admin_invite/email_message.html:8
msgid "You're invited"
msgstr "Вас пригласили"

#: templates/email/admin_invite/email_message.html:61 templates/email/admin_invite/email_subject.txt:2
msgid "You've been invited to join our platform"
msgstr "Вас пригласили присоединиться к нашей платформе"

#: templates/email/admin_invite/email_message.html:66
msgid ""
"\n"
"                An administrator has created an account for you using this email address.\n"
"                To activate your account and set your password, please confirm your email address.\n"
"                "
msgstr ""
"\n"
"                Администратор создал для вас учётную запись с этим адресом электронной почты.\n"
"                Чтобы активировать её и задать пароль, подтвердите свой адрес электронной почты.\n"
"                "

#: templates/email/admin_invite/email_message.html:74
msgid "Confirm email and set password"
msgstr "Подтвердить адрес и задать пароль"

#: templates/email/admin_invite/email_message.html:79
msgid ""
"\n"
"                If the button above does not work, you can also copy and paste the following link\n"
"                into your browser:\n"
"                "
msgstr ""
"\n"
"                Если кнопка выше не работает, скопируйте и вставьте следующую ссылку\n"
"                в свой браузер:\n"
"                "

#: templates/email/admin_invite/email_message.html:87
msgid ""
"\n"
"                After confirming your email, you will be redirected to a secure page where you can\n"
"                choose your password and finish activating your account.\n"
"                "
msgstr ""
"\n"
"                После подтверждения адреса вы попадёте на защищённую страницу, где сможете\n"
"                выбрать пароль и завершить активацию учётной записи.\n"
"                "

#: templates/email/admin_invite/email_message.html:94
msgid "If you did not expect this invitation, you can safely ignore this email."
msgstr "Если вы не ждали этого приглашения, просто проигнорируйте это письмо."

#: templates/email/password/reset_email_message.html:8
msgid "Password Reset"
msgstr "Сброс пароля"

#: templates/email/password/reset_email_message.html:73
msgid "Password Reset Request"
msgstr "Запрос на сброс пароля"

#: templates/email/password/reset_email_message.html:77
msgid "Hello"
msgstr "Здравствуйте"

#: templates/email/password/reset_email_message.html:79
msgid "You're receiving this email because you requested a password reset for your account. Please click the button below to set a new password:"
msgstr "Вы получили это письмо, потому что запросили сброс пароля для своей учётной записи. Нажмите кнопку ниже, чтобы задать новый пароль:"

#: templates/email/password/reset_email_subject.txt:2
msgid "Password reset"
msgstr "Сброс пароля"

#: templates/email/signup/email_message.html:8
msgid "Email Verification"
msgstr "Подтверждение адреса электронной почты"

#: templates/email/signup/email_message.html:65
msgid "Welcome to our platform!"
msgstr "Добро пожаловать на нашу платформу!"

#: templates/email/signup/email_message.html:70
msgid "Thank you for signing up on our website. To complete your registration, please click the button below to verify your email address:"
msgstr "Спасибо за регистрацию на нашем сайте. Чтобы завершить её, нажмите кнопку ниже и подтвердите свой адрес электронной почты:"

#: templates/email/signup/email_message.html:73
msgid "Verify Email Address"
msgstr "Подтвердить адрес электронной почты"

#: templates/email/signup/email_message.html:79
msgid "If you did not request this email, you can safely ignore it."
msgstr "Если вы не запрашивали это письмо, просто проигнорируйте его."

#: templates/email/signup/email_subject.txt:2
msgid "Welcome"
msgstr "Добро пожаловать"

